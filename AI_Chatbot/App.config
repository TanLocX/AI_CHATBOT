<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <!--
        CẤU HÌNH ỨNG DỤNG:
        - Các giá trị mặc định nằm ở đây (an toàn để push lên Git)
        - Để ghi đè bằng giá trị riêng, tạo file "secrets.config" cùng thư mục
        - Xem file "secrets.config.example" để biết cách tạo
    -->
    <appSettings file="secrets.config">
        <!-- Ollama Local AI -->
        <add key="OllamaBaseUrl" value="http://localhost:11434" />
        <add key="OllamaModel" value="llama3.2" />
        
        <!-- Gemini Cloud AI (để trống = tắt Gemini) -->
        <add key="GeminiApiKey" value="" />
    </appSettings>
</configuration>