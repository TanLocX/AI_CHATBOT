<appSettings>
    <!-- 
        FILE NÀY CHỨA CẤU HÌNH RIÊNG CỦA BẠN (BỊ GIT IGNORE)
        Các giá trị ở đây sẽ GHI ĐÈ lên giá trị mặc định trong App.config
        Chỉ cần khai báo những key bạn muốn thay đổi
    -->

    <!-- Đổi URL nếu Ollama chạy trên máy khác trong mạng LAN -->
    <add key="OllamaBaseUrl" value="http://localhost:11434" />
    
    <!-- Đổi model mặc định (ví dụ: qwen2.5, mistral, gemma2...) -->
    <add key="OllamaModel" value="llama3.2" />

    <!-- Điền API Key Gemini của bạn vào đây (lấy tại: https://aistudio.google.com/apikey) -->
    <add key="GeminiApiKey" value="DIEN_API_KEY_CUA_BAN_VAO_DAY" />
</appSettings>
